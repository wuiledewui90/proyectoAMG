{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "node scripts/validate-env.mjs && prisma migrate deploy && prisma generate && next build --webpack && node scripts/prepare-standalone.mjs",
    "hostinger:build": "node scripts/validate-env.mjs && prisma generate && next build --webpack && node scripts/prepare-standalone.mjs",
    "deploy:check": "node scripts/validate-env.mjs",
    "deploy:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-hostinger-package.ps1",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "images:webp": "node scripts/convert-images-to-webp.mjs",
    "images:supabase": "node --env-file=.env.local scripts/migrate-product-images-to-supabase.mjs",
    "catalog:images": "node scripts/import-amg-catalog-images.mjs",
    "db:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-docker-mysql.ps1",
    "db:setup:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-mysql.ps1",
    "db:docker:up": "docker compose --env-file .env.docker up -d mysql",
    "db:docker:down": "docker compose --env-file .env.docker down",
    "db:docker:logs": "docker compose --env-file .env.docker logs -f mysql",
    "db:docker:status": "docker compose --env-file .env.docker ps",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@next/env": "16.3.8",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-aspect-ratio": "1.1.1",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-collapsible": "1.1.2",
    "@radix-ui/react-context-menu": "2.2.4",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-hover-card": "1.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-menubar": "1.1.4",
    "@radix-ui/react-navigation-menu": "1.2.3",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-radio-group": "1.2.2",
    "@radix-ui/react-scroll-area": "1.2.2",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slider": "1.2.2",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-toast": "1.2.4",
    "@radix-ui/react-toggle": "1.1.1",
    "@radix-ui/react-toggle-group": "1.1.1",
    "@radix-ui/react-tooltip": "1.1.6",
    "@supabase/supabase-js": "^2.117.2",
    "@swc/helpers": "0.5.23",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "dotenv": "^17.2.4",
    "embla-carousel-react": "8.5.1",
    "exceljs": "4.4.0",
    "input-otp": "1.4.1",
    "lucide-react": "^0.544.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "^19",
    "react-day-picker": "10.0.2",
    "react-dom": "^19",
    "react-hook-form": "^7.54.1",
    "react-resizable-panels": "^2.1.7",
    "recharts": "2.15.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.5",
    "vaul": "^1.1.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.5.28",
    "prisma": "^6.19.3",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "5.7.3"
  }
}

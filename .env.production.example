# Base de datos MySQL de produccion.
DATABASE_URL="mysql://USUARIO_PRODUCCION:CLAVE_PRODUCCION@HOST_PRODUCCION:3306/BASE_PRODUCCION"

# Credenciales exclusivas de Cloudflare para produccion.
CLOUDFLARE_API_TOKEN="REEMPLAZAR_POR_TOKEN_DE_PRODUCCION"
CLOUDFLARE_ACCOUNT_ID="REEMPLAZAR_POR_ACCOUNT_ID_DE_PRODUCCION"
CLOUDFLARE_ZONE_ID="REEMPLAZAR_POR_ZONE_ID_DE_PRODUCCION"

# Acceso al panel administrativo en produccion.
ADMIN_USER="admin"
ADMIN_PASS_HASH="REEMPLAZAR_POR_HASH_BCRYPT_DE_PRODUCCION"
ADMIN_SECRET="REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_32_BYTES_O_MAS"

# Cloudflare R2 para produccion. Usar credenciales diferentes a desarrollo.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_PUBLIC_SIGNED_URL_TTL_SECONDS=3600
R2_ADMIN_SIGNED_URL_TTL_SECONDS=
R2_MEDIA_REDIRECT_CACHE_SECONDS=1800
R2_MEDIA_LOOKUP_CACHE_SECONDS=

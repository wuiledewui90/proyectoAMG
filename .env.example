# Copiar como .env.local para desarrollo. Prisma y Next.js leen ese mismo archivo.
# Base MySQL local. No reutilizar esta clave en producción.
DATABASE_URL="mysql://radiadores_amg:REEMPLAZAR_CLAVE@127.0.0.1:3307/radiadores_amg"

# URL pública exacta de la aplicación (sin barra final).
APP_URL="http://localhost:3002"

# Acceso al ERP. ADMIN_PASS_HASH debe ser bcrypt.
ADMIN_USER="admin"
ADMIN_PASS_HASH="REEMPLAZAR_POR_HASH_BCRYPT"
ADMIN_SECRET="REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS"

# Supabase: todas estas variables son exclusivas del servidor.
SUPABASE_URL="https://PROYECTO.supabase.co"
SUPABASE_SECRET_KEY=""
SUPABASE_PRODUCTS_TABLE="productos"
SUPABASE_STORAGE_BUCKET="fotos"

# MySQL en Docker. El puerto 3307 evita conflictos con MySQL instalado en Windows.
# El script `pnpm db:setup` genera claves y crea el .env real.
DATABASE_URL="mysql://radiadores_amg:REEMPLAZAR_CLAVE@127.0.0.1:3307/radiadores_amg"

# Credenciales de Cloudflare para desarrollo/preview.
CLOUDFLARE_API_TOKEN="REEMPLAZAR_POR_TOKEN_DE_DESARROLLO"
CLOUDFLARE_ACCOUNT_ID="REEMPLAZAR_POR_ACCOUNT_ID_DE_DESARROLLO"
CLOUDFLARE_ZONE_ID="REEMPLAZAR_POR_ZONE_ID_DE_DESARROLLO"

# Acceso al panel administrativo.
ADMIN_USER="admin"
ADMIN_PASS_HASH="REEMPLAZAR_POR_HASH_BCRYPT"
ADMIN_SECRET="REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_32_BYTES_O_MAS"

# Cloudflare R2 para desarrollo/preview.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_PUBLIC_SIGNED_URL_TTL_SECONDS=3600
R2_ADMIN_SIGNED_URL_TTL_SECONDS=
R2_MEDIA_REDIRECT_CACHE_SECONDS=1800
R2_MEDIA_LOOKUP_CACHE_SECONDS=
